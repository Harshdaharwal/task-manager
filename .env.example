# ═══════════════════════════════════════════════════
# Task Manager — Environment Variables
# ═══════════════════════════════════════════════════
# Is file ko `.env` ke naam se copy karo aur values bharo.
# IMPORTANT: .env file kabhi GitHub push mat karo!

# ── App ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SESSION_SECRET=change_this_to_a_very_long_random_string_here
# Aapke deployed app ka URL (WhatsApp/email links ke liye)
APP_URL=https://yourdomain.com

# ── DATABASE DRIVER ──────────────────────────────────
# 'mysql'  = MySQL database
# 'sheets' = Google Sheets as database
# 'demo'   = bina database ke demo (in-memory, restart par data reset)
DB_DRIVER=mysql

# ── MySQL ────────────────────────────────────────────
# Apne hosting panel / DB server se ye values milengi.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# ── Google Sheets (sirf DB_DRIVER=sheets ke liye) ────
# Spreadsheet ID (URL me /d/ ke baad wala part)
SHEET_ID=your_google_spreadsheet_id_here
# credentials.json file project root me rakho, YA niche env me JSON paste karo:
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
# GOOGLE_CREDENTIALS_B64=base64_encoded_credentials_json

# ── Email (Gmail SMTP) — optional ────────────────────
# Enable karne ke liye: Gmail App Password banao aur yahan bharo
# SMTP_USER=yourgmail@gmail.com  |  SMTP_PASS=16_char_app_password
EMAIL_ENABLED=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Task Manager

# ── WhatsApp API — optional ──────────────────────────
# Nayi API milne par yahan (ya whatsapp.config.js me) values bharo
WHATSAPP_ENABLED=false
AUMPFY_API_URL=
AUMPFY_API_KEY=
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_REMINDER_HOUR=10
